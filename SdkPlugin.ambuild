# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# Helper for building a Source2Toolkit plugin with AMBuild.
#
# The SDK normally lives outside a plugin's own source tree (SOURCE2TOOLKIT_SDK),
# and AMBuild's builder.Build() only reaches scripts inside the tree, so a plugin
# pulls this in the way metamod's own SdkHelpers.ambuild is pulled in -- by
# absolute path through builder.Eval():
#
#   ToolkitSdk = builder.Eval(os.path.join(os.environ['SOURCE2TOOLKIT_SDK'],
#                                          'SdkPlugin.ambuild'), {})
#   ...
#   ToolkitSdk.AddToBinary(binary, sdk)
#
# AddToBinary() adds the SDK's include paths, its sources and the hl2sdk
# translation units it owns. The objects end up inside the plugin binary, which
# is what the CMake path produces too -- there the SDK is a static library, and
# a static library is just those same objects.
#
# Hooks are KHook, header-only for a plugin: the engine comes from metamod at
# load time. The headers are the SDK's own vendor/khook submodule (nothing of
# it is built), so a plugin needs no metamod-source checkout.
# TOOLKIT_KHOOK_COMMIT, defined from that submodule, is what TOOLKIT_SAVEVARS()
# compares with the core's own KHook at plugin load.
import os, subprocess

class ToolkitSdkPlugin(object):
  def __init__(self):
    self.sourcePath = os.environ.get('SOURCE2TOOLKIT_SDK')
    if not self.sourcePath or not os.path.isdir(self.sourcePath):
      raise Exception('SOURCE2TOOLKIT_SDK is not set to a valid directory')

    self.khookPath = os.path.join(self.sourcePath, 'vendor', 'khook')
    if not os.path.isfile(os.path.join(self.khookPath, 'include', 'khook.hpp')):
      raise Exception('KHook headers not found at {} -- initialise the submodule: '
                      'git submodule update --init --recursive'.format(self.khookPath))

    # Mirrors CMakeLists.txt: "unknown" when git cannot say, which the
    # load-time check reports but lets through.
    try:
      out = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=self.khookPath,
                                    stderr=subprocess.DEVNULL)
      self.khookCommit = out.decode('ascii', 'ignore').strip() or 'unknown'
    except Exception:
      self.khookCommit = 'unknown'

  def AddPublicIncludes(self, binary):
    # The one call a consumer of "source2toolkit/IToolkitPlugin.h" needs.
    # KHook is in there because IToolkitPlugin.h includes "khook.hpp".
    binary.compiler.cxxincludes += [
      os.path.join(self.sourcePath, 'public'),
      os.path.join(self.sourcePath, 'src'),
      os.path.join(self.khookPath, 'include'),
    ]

  def AddSdkIncludes(self, binary, sdk):
    # Folders the toolkit headers reach into by bare name that are not in the
    # manifests' own include list. Kept in step with CMakeLists.txt.
    binary.compiler.cxxincludes += [
      os.path.join(sdk['path'], 'public', 'schemasystem'),
      os.path.join(sdk['path'], 'public', 'entity2'),
      os.path.join(sdk['path'], 'public', 'mathlib'),
      os.path.join(sdk['path'], 'public', 'tier0'),
      os.path.join(sdk['path'], 'public', 'tier1'),
      os.path.join(sdk['path'], 'game', 'server'),
      os.path.join(sdk['path'], 'thirdparty', 'protobuf-3.21.8', 'src'),
    ]

  def Sources(self, sdk):
    sources = []

    for root, _, files in os.walk(os.path.join(self.sourcePath, 'src')):
      for f in files:
        if f.endswith('.cpp'):
          sources += [os.path.join(root, f)]

    # The hl2sdk translation units the toolkit owns; a plugin must not add
    # these itself as well.
    sources += [
      os.path.join(sdk['path'], 'public', 'tier0', 'memoverride.cpp'),
      os.path.join(sdk['path'], 'tier1', 'keyvalues3.cpp'),
      os.path.join(sdk['path'], 'tier1', 'convar.cpp'),
      os.path.join(sdk['path'], 'entity2', 'entityidentity.cpp'),
      os.path.join(sdk['path'], 'entity2', 'entitysystem.cpp'),
      os.path.join(sdk['path'], 'entity2', 'entitykeyvalues.cpp'),
    ]

    return sources

  def ProtoSources(self, sdk):
    # The game protobufs, from s2sdk's own protos.
    names = [
      'common/network_connection.proto',
      'common/networkbasetypes.proto',
      'game/shared/cs/cs_gameevents.proto',
      'game/shared/cs/cs_usercmd.proto',
      'game/shared/base_gcmessages.proto',
      'game/shared/econ/econ_gcmessages.proto',
      'common/engine_gcmessages.proto',
      'gcsdk/gcsdk_gcmessages.proto',
      'gcsdk/gcsystemmsgs.proto',
      'game/shared/cstrike15/cstrike15_gcmessages.proto',
      'game/shared/cstrike15/cstrike15_usermessages.proto',
      'common/source2_steam_stats.proto',
      'common/netmessages.proto',
      'networksystem/networksystem_protomessages.proto',
      'gcsdk/steammessages.proto',
      'game/shared/usercmd.proto',
      'game/shared/usermessages.proto',
      'game/shared/gameevents.proto',
      'game/shared/clientmessages.proto',
      'game/shared/te.proto',
      'common/valveextensions.proto',
    ]
    return [os.path.join(sdk['path'], *name.split('/')) for name in names]

  def Protoc(self, builder, sdk_target):
    # The protos import each other by name, also from folders hl2sdk-manifests
    # doesn't search.
    sdk = sdk_target.sdk
    protoc = builder.tools.Protoc(protoc=sdk_target.protoc, sources=self.ProtoSources(sdk))
    protoc.protoc.includes += [
      os.path.join(sdk['path'], 'gcsdk'),
      os.path.join(sdk['path'], 'game', 'shared', 'cstrike15'),
    ]
    return protoc

  def Defines(self, binary):
    binary.compiler.defines += [
      'META_IS_SOURCE2',
      '_ITERATOR_DEBUG_LEVEL=0',
      # Read back by TOOLKIT_SAVEVARS() and compared with the core's KHook.
      'TOOLKIT_KHOOK_COMMIT="{}"'.format(self.khookCommit),
    ]
    if binary.compiler.target.platform == 'linux':
      # Every consumer has to agree with the SDK here, or std::string crosses
      # the plugin boundary with two different layouts.
      binary.compiler.defines += ['_GLIBCXX_USE_CXX11_ABI=0']

  def AddToBinary(self, binary, sdk):
    self.AddPublicIncludes(binary)
    self.AddSdkIncludes(binary, sdk)
    self.Defines(binary)
    binary.sources += self.Sources(sdk)
    self.AddSteamApi(binary, sdk)

  def AddSteamApi(self, binary, sdk):
    # Every plugin links s2sdk's Steam API, as with CMake (s2sdk::steam_api).
    if binary.compiler.target.platform == 'linux':
      binary.compiler.postlink += [os.path.join(sdk['path'], 'lib', 'linux64', 'libsteam_api.so')]
    elif binary.compiler.target.platform == 'windows':
      binary.compiler.postlink += [os.path.join(sdk['path'], 'lib', 'public', 'win64', 'steam_api64.lib')]


rvalue = ToolkitSdkPlugin()
